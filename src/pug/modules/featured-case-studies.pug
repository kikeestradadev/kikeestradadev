//- Re-enable by uncommenting include in src/pug/pages/index.pug
-
	const caseStudies = [
		{
			title: 'AI-Enabled MVP Delivery',
			subtitle: 'Trigal Media · Senior Software Engineer · Sep 2025 – Current',
			challenge: 'A junior-heavy team needed production-ready MVPs across legal, healthcare, education, and SMB products under tight delivery cycles.',
			solution: 'Defined frontend architecture, API integration patterns, and delivery standards — connecting React/TypeScript interfaces with CMS, Laravel, AI APIs, and RAG workflows. Architecture and code review stayed human-owned.',
			technologies: 'React · Next.js · Astro · TypeScript · WordPress · Laravel · AI APIs · RAG · Cursor',
			impact: 'Accelerated MVP delivery, improved engineering consistency through mentoring and reusable Cursor rules, and reduced delivery ambiguity with scoped execution plans.'
		},
		{
			title: 'BetAnySports Platform Modernization',
			subtitle: 'BetUS / BetAnything · Senior Software Engineer · Aug 2021 – Aug 2025',
			challenge: 'A multi-brand sportsbook environment needed platform modernization and a planned 12-month rebrand without disrupting high-traffic operations.',
			solution: 'Owned frontend architecture for BetAnything.eu; unblocked complex property delivery across Remix, Strapi, and Laravel; established testing standards that reduced release risk.',
			technologies: 'React · Remix · TypeScript · Strapi · WordPress · PHP · Laravel · Jest · Cypress',
			impact: 'Supported 1M+ monthly users; completed a planned 12-month platform rebrand in 6 months with React/Remix/Strapi; established Jest, React Testing Library, and Cypress as production standards.'
		}
	]

div(class="main-container bg-gradient-to-br from-slate-50/80 via-white to-blue-50/30" id="featured-projects")
	div(class="container py-10 lg:py-14")
		div(class="mb-8 text-center")
			h2(class="text-3xl lg:text-4xl font-bold text-[var(--base-color)] mb-3 inline-block relative") Featured Technical Projects
			div(class="w-24 h-1 bg-gradient-to-r from-[var(--base-color)] to-blue-600 rounded-full mx-auto")
		div(class="grid grid-cols-1 lg:grid-cols-2 gap-6")
			each study in caseStudies
				div(class="bg-white rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300")
					h3(class="text-xl font-bold text-gray-900 mb-1")= study.title
					p(class="text-sm text-[var(--base-color)] font-medium mb-4")= study.subtitle
					div(class="space-y-3 text-sm text-gray-700")
						div
							p(class="text-xs font-semibold text-[var(--base-color)] uppercase tracking-wide mb-1") Challenge
							p(class="leading-relaxed")= study.challenge
						div
							p(class="text-xs font-semibold text-[var(--base-color)] uppercase tracking-wide mb-1") Solution
							p(class="leading-relaxed")= study.solution
						div
							p(class="text-xs font-semibold text-[var(--base-color)] uppercase tracking-wide mb-1") Technologies
							p(class="leading-relaxed font-medium text-gray-800")= study.technologies
						div
							p(class="text-xs font-semibold text-[var(--base-color)] uppercase tracking-wide mb-1") Business Impact
							p(class="leading-relaxed")= study.impact
