//- Trigal Media
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white via-blue-50/30 to-indigo-50/20 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors") Trigal Media
				div(class="flex flex-wrap gap-1.5 mb-2")
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") MVP Delivery
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") RAG Integrations
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") Freelance / Part-time
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-2") Senior Software Engineer (Freelance / Part-time)
				p(class="text-sm text-green-600 font-medium mb-3 flex items-center gap-2")
					span(class="inline-block w-2 h-2 rounded-full bg-green-500 shrink-0" aria-hidden="true")
					span Currently available for full-time opportunities alongside this engagement.
			div(class="flex-shrink-0")
				+employmentDate('Sep 2025 - Current', '1 yr')
		div(class="space-y-4")
			div(class="space-y-3")
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Accelerated AI-enabled MVP delivery across legal, healthcare, education, and SMB products by defining frontend architecture, API integration patterns, and delivery standards for a junior-heavy team.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Integrated AI APIs and RAG workflows into production-ready products by connecting React/TypeScript interfaces with CMS, Laravel, and backend services.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Improved engineering consistency across active projects by mentoring junior developers through code reviews, pairing, reusable Cursor rules, and practical delivery standards.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Reduced delivery ambiguity by translating product requirements into scoped execution plans with architecture, design, and stakeholder alignment.
			+stackBadges(['React', 'Next.js', 'Astro', 'TypeScript', 'Node.js', 'WordPress', 'PHP', 'Laravel', 'AI APIs', 'RAG', 'Cursor'])
