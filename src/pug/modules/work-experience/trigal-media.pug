//- Trigal Media
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white via-blue-50/30 to-indigo-50/20 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors") Trigal Media
				div(class="flex flex-wrap gap-1.5 mb-2")
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") AI-Assisted Product Development
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") RAG Integrations
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") Freelance / Part-time
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-2") Senior Web Developer Lead (Freelance / Part-time)
				p(class="text-sm text-green-600 font-medium mb-3 flex items-center gap-2")
					span(class="inline-block w-2 h-2 rounded-full bg-green-500 shrink-0" aria-hidden="true")
					span Currently available for full-time opportunities alongside this engagement.
			div(class="flex-shrink-0")
				+employmentDate('Sep 2025 - Current', '9 mos')
		div(class="space-y-4")
			div
				p(class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2") Role Overview
				p(class="text-gray-700 leading-relaxed text-base")
					| Software and product lead for a Costa Rica–based startup shipping AI-enabled MVPs across legal, healthcare, education, and SMB verticals. I own architecture direction, code reviews, and hands-on delivery — helping a junior-heavy team move from idea to production-ready product foundations.
			div
				p(class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2") Key Project — AI-Assisted Product Development
				p(class="text-gray-700 leading-relaxed text-base")
					| Clients needed practical MVPs with AI capabilities under tight cycles. I established reusable patterns, review standards, and AI-assisted delivery workflows so the team could ship maintainable products faster — including AI API and RAG integrations where the product required them.
			div(class="space-y-3")
				p(class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2") Key Achievements
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Accelerated MVP delivery across legal, healthcare, education, and SMB product initiatives through architecture guidance and hands-on delivery
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Integrated AI APIs and RAG workflows into production products with maintainable software patterns
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Applied AI-assisted workflows (Cursor, Claude, ChatGPT) to speed debugging, prototyping, and documentation without skipping review
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold") •
						span Mentored junior developers through code reviews, pairing, and practical engineering standards
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold") •
						span Partnered with product and design stakeholders on scoped execution plans when projects are active
			+stackBadges(['React', 'Next.js', 'Astro', 'TypeScript', 'WordPress', 'Laravel', 'AI APIs', 'RAG', 'AI-Assisted Development'])
