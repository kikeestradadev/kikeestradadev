//- Trigal Media
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white via-blue-50/30 to-indigo-50/20 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors") Trigal Media
				div(class="flex flex-wrap gap-1.5 mb-2")
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") Digital Product Development
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") Product Architecture
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") AI Integrations
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-3") Founder & Software Engineer
			div(class="flex-shrink-0")
				+employmentDate('Sep 2025 – Present', '1 yr')
		div(class="space-y-4")
			div(class="space-y-3")
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Lead the technical direction and delivery of AI-enabled MVPs, defining frontend architecture, API integration patterns, and practical delivery standards.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Build product experiences by connecting React and TypeScript interfaces with CMS platforms, Laravel and backend services, AI APIs, and RAG workflows.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Translate business and product needs into scoped execution plans, aligning architecture, design, implementation, and stakeholders.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Establish practical engineering practices through code review, mentoring, reusable Cursor rules, and delivery standards.
			+stackBadges(['React', 'Next.js', 'Astro', 'TypeScript', 'Node.js', 'WordPress', 'PHP', 'Laravel', 'AI APIs', 'RAG', 'Cursor'])
