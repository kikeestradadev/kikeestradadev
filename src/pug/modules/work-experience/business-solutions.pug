//- Gambling Industry
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white to-gray-50/50 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors mb-2") Gambling Industry — JazzSports / MyBookie
				div(class="flex flex-wrap gap-1.5 mb-2")
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") JazzSports
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") MyBookie
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-3") Senior Software Engineer
			div(class="flex-shrink-0")
				+employmentDate('Sep 2015 - Dec 2019', '4 yrs 3 mos')
		div(class="space-y-4")
			div(class="space-y-3")
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Led delivery for 25 designers and developers across two teams by owning technical direction, code quality, hiring support, mentoring, and delivery schedules.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Managed 40+ major projects across sportsbook, casino, email, SEO, and commercial brand properties by coordinating WordPress, PHP, .NET, and JavaScript delivery.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Reduced production delivery time by approximately 50% by improving planning, review standards, and Agile workflow execution.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Improved multi-brand platform consistency by training developers and UX/UI teams on maintainable frontend and production standards.
			+stackBadges(['WordPress', 'PHP', '.NET', 'JavaScript', 'SEO', 'Email & banner production'])
