//- Gambling Industry
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white via-blue-50/30 to-indigo-50/20 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors mb-2") Gambling Industry — BetUS / BetAnything
				div(class="flex flex-wrap gap-1.5 mb-2")
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") BetUS
					span(class="text-[11px] px-2 py-0.5 rounded bg-[var(--base-color)]/10 border border-[var(--base-color)]/15 text-[var(--base-color)] font-semibold") BetAnything
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-3") Senior Software Engineer
			div(class="flex-shrink-0")
				+employmentDate('Aug 2021 - Aug 2025', '4 yrs')
		div(class="space-y-4")
			div(class="space-y-3")
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Cut a planned 12-month platform rebrand to 6 months by owning frontend architecture, React/Remix implementation, Strapi integration, and cross-team delivery standards.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Supported 1M+ monthly users by modernizing high-traffic React/TypeScript, WordPress, PHP, Laravel, Strapi, and API-integrated web platforms.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Delivered 10+ custom property themes by unblocking complex WordPress/PHP implementations the team had previously been unable to ship.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Improved release confidence by establishing Jest, React Testing Library, and Cypress standards across production workflows.
			+stackBadges(['React', 'Remix', 'TypeScript', 'WordPress', 'PHP', 'Laravel', 'Strapi', 'REST APIs', 'Jest', 'React Testing Library', 'Cypress'])
