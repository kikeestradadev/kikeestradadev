//- Experian Marketing Services
include ../../mixins/employment-date
include ../../mixins/stack-badges
div
	div(class="bg-gradient-to-br from-white to-gray-50/50 rounded-xl shadow-lg ring-1 ring-[var(--base-color)]/10 p-6 lg:p-8 border-l-4 border-[var(--base-color)] hover:shadow-2xl transition-shadow duration-300 group backdrop-blur-sm")
		div(class="flex flex-col m:flex-row m:items-start m:justify-between mb-4 gap-3")
			div(class="flex-1")
				h3(class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-[var(--base-color)] transition-colors mb-2") Experian Marketing Services
				h4(class="text-lg font-semibold text-[var(--base-color)] mb-3") Senior Front End
			div(class="flex-shrink-0")
				+employmentDate('Aug 2012 - Oct 2015', '3 yrs 2 mos')
		div(class="space-y-4")
			div(class="space-y-3")
				ul(class="space-y-2.5 list-none text-gray-700 text-base")
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="font-semibold text-gray-900 leading-snug") Increased campaign output by building reusable frontend and email template systems for high-volume enterprise campaigns, landing pages, and forms.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Reduced onboarding time for incoming developers by creating training workflows for Experian's proprietary campaign platform.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Reduced rework before handoff by improving cross-client QA checks, brand-standard reviews, and reusable implementation patterns.
					li(class="flex items-start gap-2")
						span(class="text-[var(--base-color)] font-bold shrink-0") •
						span(class="leading-snug") Supported enterprise client delivery by developing HTML, CSS, JavaScript, email, A/B testing, and landing page assets at production scale.
			+stackBadges(['HTML', 'CSS', 'JavaScript', 'Email Development', 'A/B Testing', 'Cross-client QA'])
