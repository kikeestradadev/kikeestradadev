-
	const skillCategories = [
		{
			title: 'Frontend',
			items: ['React', 'Next.js', 'Remix', 'Astro', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Tailwind CSS', 'WordPress']
		},
		{
			title: 'Backend / Application',
			items: ['Node.js', 'Express', 'REST APIs', 'GraphQL', 'PHP', 'Laravel', 'Strapi']
		},
		{
			title: 'Data',
			items: ['PostgreSQL', 'MySQL', 'Supabase']
		},
		{
			title: 'Infrastructure / Deployment',
			items: ['Git-based workflows', 'GitHub Actions', 'GitLab CI', 'Deployment & release management']
		},
		{
			title: 'Testing',
			items: ['Jest', 'React Testing Library', 'Cypress']
		}
	]

div(class="main-container py-10 lg:py-12 bg-white" id="skills")
	div(class="container")
		div(class="mb-6 lg:mb-8 text-center")
			h2(class="text-3xl lg:text-4xl font-bold text-[var(--base-color)] mb-3 inline-block relative") Technical Stack
			div(class="w-24 h-1 bg-gradient-to-r from-[var(--base-color)] to-blue-600 rounded-full mx-auto")
			p(class="text-gray-600 mt-4 max-w-2xl mx-auto text-sm") Tools I actually ship with. The work above is the evidence.
		div(class="rounded-xl border border-gray-200/80 bg-slate-50/50 p-5 sm:p-6 lg:p-8")
			div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10")
				each category in skillCategories
					div
						h3(class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-3")= category.title
						div(class="flex flex-wrap")
							each skill in category.items
								span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2")= skill
			div(class="mt-6 pt-5 border-t border-gray-200/80")
				p(class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2") Languages
				div(class="flex flex-wrap")
					span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2") English — Professional fluency (C1)
					span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2") Spanish — Native
