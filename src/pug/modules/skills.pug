-
	const skillCategories = [
		{
			title: 'Frontend Architecture',
			items: ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Remix', 'Astro', 'Design systems', 'Component libraries', 'SSR · SSG · ISR', 'Accessibility · WCAG', 'Core Web Vitals', 'Micro frontends']
		},
		{
			title: 'Full-Stack Product Delivery',
			items: ['Node.js', 'PHP', 'Laravel', 'REST APIs', 'GraphQL', 'Headless CMS', 'Strapi', 'WordPress · Gutenberg', 'Supabase', 'Express.js']
		},
		{
			title: 'Backend & Data',
			items: ['PostgreSQL', 'MySQL', 'RESTful API Design', 'JWT Authentication & Authorization', 'API Testing with Postman']
		},
		{
			title: 'Testing & Quality',
			items: ['Jest', 'React Testing Library', 'Cypress', 'Unit & integration testing', 'QA workflows']
		},
		{
			title: 'CI/CD & Delivery',
			items: ['Git-based workflows (Git Flow, GitHub Flow)', 'CI/CD Pipelines (GitHub Actions, GitLab CI)', 'Deployment & Release Management', 'Agile · Scrum']
		},
		{
			title: 'AI-Assisted Productivity',
			items: ['Cursor', 'Claude', 'ChatGPT', 'Cursor rules', 'AI APIs', 'RAG', 'Documentation', 'Debugging', 'Prototyping', 'Human-owned architecture']
		},
		{
			title: 'UI & Performance',
			items: ['Tailwind CSS', 'Code splitting', 'Bundle optimization', 'Data Visualization & Dashboards']
		},
		{
			title: 'Developer Workflow',
			items: ['Code review & standards', 'Technical planning', 'Developer productivity', 'Cross-functional collaboration']
		},
		{
			title: 'Leadership',
			items: ['Mentoring', 'Code Review', 'Architecture Governance', 'Engineering Standards', 'Team Collaboration']
		}
	]

div(class="main-container py-10 lg:py-12 bg-white" id="skills")
	div(class="container")
		div(class="mb-6 lg:mb-8 text-center")
			h2(class="text-3xl lg:text-4xl font-bold text-[var(--base-color)] mb-3 inline-block relative") Technical Skills
			div(class="w-24 h-1 bg-gradient-to-r from-[var(--base-color)] to-blue-600 rounded-full mx-auto")
			p(class="text-gray-600 mt-4 max-w-2xl mx-auto text-sm") Frontend architecture as the core depth, with full-stack product delivery and AI-assisted workflows for documentation, debugging, and prototyping.
		div(class="rounded-xl border border-gray-200/80 bg-slate-50/50 p-5 sm:p-6 lg:p-8")
			div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10")
				each category in skillCategories
					div
						h3(class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-3")= category.title
						div(class="flex flex-wrap")
							each skill in category.items
								span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2")= skill
			div(class="mt-6 pt-5 border-t border-gray-200/80")
				p(class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2") Languages
				div(class="flex flex-wrap")
					span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2") English — Professional fluency (C1)
					span(class="inline-block bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full mr-2 mb-2") Spanish — Native
