-
	const buildPrinciples = [
		{
			title: 'Architecture first',
			text: 'Define ownership, boundaries, and reusable patterns — starting with frontend architecture, then extending through APIs, CMS, and backend integrations before scaling features.'
		},
		{
			title: 'AI-assisted coding',
			text: 'Leverage AI through prompt engineering, custom rules, and reusable skills to accelerate debugging, prototyping, and documentation — augmenting productivity without compromising engineering judgment.'
		},
		{
			title: 'Human-reviewed decisions',
			text: 'Architecture, product trade-offs, and production changes stay under engineering ownership.'
		},
		{
			title: 'Rapid prototyping',
			text: 'Validate product direction quickly, then harden what proves valuable.'
		},
		{
			title: 'Testing & quality',
			text: 'Protect delivery with practical unit, integration, and end-to-end coverage where risk is highest.'
		},
		{
			title: 'Performance & maintainability',
			text: 'Ship software that stays fast, accessible, and workable for the next team.'
		},
		{
			title: 'Full-stack product delivery',
			text: 'Ship the product layer, not just the UI: React/TypeScript, API and CMS integrations, backend collaboration, testing, and release workflows.'
		},
		{
			title: 'Developer productivity',
			text: 'Improve standards, reviews, and workflows so teams deliver more with less friction.'
		},
		{
			title: 'End-to-end delivery',
			text: 'Own the path from architecture to production: testable code, CI/CD, and reliable releases — with APIs, CMS, and backend integrations as part of the same delivery loop.'
		}
	]

div(class="main-container bg-white border-y border-gray-100" id="how-i-build")
	div(class="container py-10 lg:py-14")
		div(class="mb-8 text-center")
			h2(class="text-3xl lg:text-4xl font-bold text-[var(--base-color)] mb-3 inline-block relative") My Engineering Philosophy: Building for Impact
			div(class="w-24 h-1 bg-gradient-to-r from-[var(--base-color)] to-blue-600 rounded-full mx-auto")
			p(class="text-gray-700 mt-4 max-w-3xl mx-auto text-base") My approach combines frontend architecture as the core depth with pragmatic full-stack product delivery. The goal is always the same: ship high-quality software that delivers measurable business value, faster.
			p(class="text-gray-700 mt-4 max-w-3xl mx-auto text-base") AI is a multiplier. Architecture, engineering decisions, and product thinking remain human-driven.
		div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5")
			each item in buildPrinciples
				div(class="bg-slate-50/80 rounded-xl border border-gray-200/80 p-5 hover:shadow-md transition-shadow duration-300")
					h3(class="text-sm font-semibold uppercase tracking-wide text-blue-600 mb-2")= item.title
					p(class="text-sm text-gray-700 leading-relaxed")= item.text
