-
	const buildPrinciples = [
		{
			title: 'Frontend Architecture',
			text: 'Ownership, boundaries, and reusable patterns for multi-brand and high-traffic interfaces — component platforms, headless CMS, and SSR/SSG where the product needs them.'
		},
		{
			title: 'Full Stack Web Applications',
			text: 'Modern web products across the stack: React, Next.js, and Remix on the client; Node, Laravel, Strapi, and WordPress where the application lives.'
		},
		{
			title: 'UI Engineering',
			text: 'Production interfaces at enterprise scale: design-to-code, campaign and product surfaces, and UI that has to hold up under real traffic and real brand constraints.'
		},
		{
			title: 'Design Systems',
			text: 'Component libraries and shared UI standards that made team delivery faster and more consistent — used across properties, not as a side documentation project.'
		},
		{
			title: 'APIs & Data',
			text: 'REST and GraphQL integrations, headless CMS (Strapi), and data stores used in real products — PostgreSQL, MySQL, and Supabase.'
		},
		{
			title: 'Performance',
			text: 'Core Web Vitals, code splitting, and bundle discipline on platforms that already have users. Speed is a delivery constraint, not a polish pass.'
		},
		{
			title: 'Accessibility',
			text: 'WCAG-oriented interface work as part of UI engineering — semantic structure, usable components, and quality checks before handoff.'
		},
		{
			title: 'Application Architecture',
			text: 'Turn product goals into architecture that a team can actually ship — clearer ownership, reusable platforms, and standards that survive the next feature.'
		},
		{
			title: 'AI-assisted development',
			text: 'Cursor, Claude, and ChatGPT in the daily workflow — plus AI API and RAG integrations in shipped MVPs. Architecture and review stay human-owned.'
		},
		{
			title: 'Developer Experience',
			text: 'Code review, engineering standards, mentoring, and workflow design so teams deliver with less friction — from junior-heavy startups to 25-person delivery orgs.'
		}
	]

div(class="main-container bg-white border-y border-gray-100" id="engineering")
	div(class="container py-10 lg:py-14")
		div(class="mb-8 text-center")
			h2(class="text-3xl lg:text-4xl font-bold text-[var(--base-color)] mb-3 inline-block relative") Engineering
			div(class="w-24 h-1 bg-gradient-to-r from-[var(--base-color)] to-blue-600 rounded-full mx-auto")
			p(class="text-gray-700 mt-4 max-w-3xl mx-auto text-base") Frontend depth first. Broader application ownership as the work required it.
		div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5")
			each item in buildPrinciples
				div(class="bg-slate-50/80 rounded-xl border border-gray-200/80 p-5 hover:shadow-md transition-shadow duration-300")
					h3(class="text-sm font-semibold uppercase tracking-wide text-blue-600 mb-2")= item.title
					p(class="text-sm text-gray-700 leading-relaxed")= item.text
