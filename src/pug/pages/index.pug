extends ../config/template 
append config
	-currentPage		= "Home"
	-siteName			= 'Enrique Estrada Nunez'
	-content			= 'Senior Software Engineer'
	-pageDescription	= 'Senior Software Engineer with deep frontend architecture expertise and full-stack product delivery ownership. Cut a 12-month BetUS rebrand to 6 months. Supported 1M+ monthly users across React, Remix, and Strapi.'
	-siteUrl			= 'https://kikeestradadev.github.io/kikeestradadev'
	-ogImage			= siteUrl + '/images/icon_1024.png'
	-ogTitle			= siteName + ' | ' + content
block main-header
	include ../modules/top-nav-title
block main-container 
	include ../modules/profile
	include ../modules/what-im-looking-for
	include ../modules/how-i-build-software
	//- Professional Impact hidden — redundant with header summary and Career Highlights. Re-enable: include ../modules/professional-impact
	include ../modules/career-highlights
	include ../modules/work-experience
	//- Featured Technical Projects hidden — content merged into Work Experience (Trigal Media, BetUS). Re-enable: include ../modules/featured-case-studies
	//- Core Specializations hidden — redundant with hero, Career Highlights, and Technical Skills. Re-enable: include ../modules/core-specializations
	include ../modules/skills
	include ../modules/portfolio
	//- TODO: Re-enable Professional References when verified LinkedIn recommendations or client quotes are available.
	//- include ../modules/professional-references
block main-footer
	include ../modules/footer
block scripts
	script.
		(function () {
			var desktopQuery = window.matchMedia('(min-width: 1280px)');
			var portfolioSwiper = null;

			function destroyPortfolioSwiper() {
				if (!portfolioSwiper) return;
				portfolioSwiper.destroy(true, true);
				portfolioSwiper = null;
			}

			function initPortfolioSwiper() {
				var el = document.querySelector('.portfolio-swiper');
				if (!el || typeof Swiper === 'undefined') return;
				if (desktopQuery.matches) {
					destroyPortfolioSwiper();
					return;
				}
				if (portfolioSwiper) return;
				portfolioSwiper = new Swiper(el, {
					slidesPerView: 1.12,
					spaceBetween: 16,
					grabCursor: true,
					watchOverflow: true,
					observer: true,
					observeParents: true,
					pagination: {
						el: '.portfolio-swiper-pagination',
						clickable: true
					},
					navigation: {
						nextEl: '.portfolio-swiper-next',
						prevEl: '.portfolio-swiper-prev'
					},
					breakpoints: {
						480: {
							slidesPerView: 1.2,
							spaceBetween: 16
						},
						640: {
							slidesPerView: 2,
							spaceBetween: 20
						},
						960: {
							slidesPerView: 2.25,
							spaceBetween: 24
						}
					}
				});
			}

			if (desktopQuery.addEventListener) {
				desktopQuery.addEventListener('change', initPortfolioSwiper);
			} else if (desktopQuery.addListener) {
				desktopQuery.addListener(initPortfolioSwiper);
			}
			initPortfolioSwiper();
		})();
